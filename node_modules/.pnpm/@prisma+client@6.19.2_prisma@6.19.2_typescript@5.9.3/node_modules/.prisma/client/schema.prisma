model ActivityLog {
  id String @id @default(cuid())

  // Relations
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Activity details
  activityType ActivityType
  entityType   EntityType
  entityId     String

  // Actor
  actorId   String
  actorName String
  actorRole MemberRole

  // Details
  action      String
  description String

  // Changes (JSON)
  oldValue Json?
  newValue Json?

  // Metadata
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([groupId, activityType])
  @@index([groupId, entityType, entityId])
  @@map("activity_logs")
}

enum ActivityType {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  DISBURSE
  CONFIRM
  WAIVE
  SETTLE
}

enum EntityType {
  MEMBER
  DEPOSIT
  LOAN
  REPAYMENT
  FINE
  EXPENSE
  BANK_INTEREST
  GROUP_RULE
  SETTLEMENT
}

model BankInterest {
  id String @id @default(cuid())

  // Relations
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Interest details
  amount        Decimal @db.Decimal(10, 2)
  monthYear     String // Format: "YYYY-MM"
  bankName      String?
  accountNumber String?

  // Status
  status InterestStatus @default(PENDING)

  // Confirmation
  confirmedById String?
  confirmedAt   DateTime?
  creditedDate  DateTime?

  // Notes
  notes String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transaction Transaction?

  @@map("bank_interests")
}

enum InterestStatus {
  PENDING
  CONFIRMED
}

model Deposit {
  id String @id @default(cuid())

  // Relations
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Deposit details
  monthYear String // Format: "YYYY-MM"
  amount    Decimal  @db.Decimal(10, 2)
  dueDate   DateTime

  // Payment details
  status      DepositStatus @default(PENDING)
  paidDate    DateTime?
  paymentMode PaymentMode?
  voucherUrl  String?

  // Fine
  fineAmount Decimal @default(0) @db.Decimal(10, 2)
  fineId     String?
  fine       Fine?   @relation(fields: [fineId], references: [id])

  // Advance/Partial
  isAdvance       Boolean @default(false)
  isPartial       Boolean @default(false)
  parentDepositId String?

  // Approval
  confirmedById String?
  confirmedAt   DateTime?

  // Notes
  notes String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  receipt     Receipt?
  transaction Transaction?

  @@unique([groupId, memberId, monthYear])
  @@map("deposits")
}

enum DepositStatus {
  PENDING
  PAID
  LATE
  WAIVED
}

model Document {
  id String @id @default(cuid())

  // Relations
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Document details
  documentType DocumentType
  fileName     String
  fileSize     Int // in bytes
  mimeType     String

  // Storage
  storageUrl  String // S3/Cloud storage URL
  storagePath String // Path in storage

  // Reference (what is this document for?)
  entityType EntityType?
  entityId   String?

  // Metadata
  description  String?
  uploadedById String
  uploadedAt   DateTime @default(now())

  // Version control
  version  Int     @default(1)
  isLatest Boolean @default(true)

  // Access control
  isPublic Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([groupId, documentType])
  @@index([entityType, entityId])
  @@map("documents")
}

enum DocumentType {
  RECEIPT
  MONTHLY_REPORT
  YEARLY_REPORT
  SETTLEMENT_REPORT
  EXPENSE_INVOICE
  LOAN_AGREEMENT
  GROUP_RULES
  OTHER
}

model Expense {
  id String @id @default(cuid())

  // Relations
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Expense details
  expenseType ExpenseType
  amount      Decimal     @db.Decimal(10, 2)
  description String

  // Status
  status ExpenseStatus @default(SUGGESTED)

  // Suggestion
  suggestedById String?
  suggestedBy   Member?   @relation("SuggestedBy", fields: [suggestedById], references: [id])
  suggestedAt   DateTime?

  // Approval
  approvedById String?
  approvedAt   DateTime?

  // Payment
  paidDate    DateTime?
  paymentMode PaymentMode?

  // Receipt/Invoice
  hasReceipt Boolean @default(false)
  receiptUrl String?

  // Notes
  notes String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  receipt     Receipt?
  transaction Transaction?

  @@map("expenses")
}

enum ExpenseType {
  MEETING
  OUTING
  FOOD
  SOFTWARE
  HOSTING
  ACCOUNTANT
  AUDIT
  MISCELLANEOUS
}

enum ExpenseStatus {
  SUGGESTED
  APPROVED
  PAID
  REJECTED
}

model Fine {
  id String @id @default(cuid())

  // Relations
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Fine details
  fineType FineCategory
  amount   Decimal      @db.Decimal(10, 2)
  reason   String

  // Status
  status      FineStatus   @default(PENDING)
  paidDate    DateTime?
  paymentMode PaymentMode?

  // Waiver
  isWaived     Boolean   @default(false)
  waivedBy     String?
  waiverReason String?
  waivedAt     DateTime?

  // Approval
  confirmedById String?
  confirmedAt   DateTime?

  // Notes
  notes String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  deposits    Deposit[]
  repayments  LoanRepayment[]
  receipt     Receipt?
  transaction Transaction?

  @@map("fines")
}

enum FineCategory {
  LATE_DEPOSIT
  LATE_EMI
  OTHER
}

enum FineStatus {
  PENDING
  PAID
  WAIVED
}

model Group {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Status
  status   GroupStatus @default(ACTIVE)
  closedAt DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members         Member[]
  rules           GroupRule[]
  deposits        Deposit[]
  loans           Loan[]
  expenses        Expense[]
  bankInterests   BankInterest[]
  transactions    Transaction[]
  activityLogs    ActivityLog[]
  receipts        Receipt[]
  monthlyReports  MonthlyReport[]
  receiptCounters ReceiptCounter[]
  balances        GroupBalance[]
  documents       Document[]
  notifications   Notification[]

  @@map("groups")
}

enum GroupStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

model GroupRule {
  id String @id @default(cuid())

  // Group relation
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Rule details
  ruleType RuleType

  // Membership rules
  registrationFee Decimal? @db.Decimal(10, 2)

  // Deposit rules
  monthlyDepositAmount Decimal? @db.Decimal(10, 2)
  depositDueDay        Int? // Day of month (1-31)
  minDepositMonths     Int? // Months of deposit before loan eligibility

  // Fine rules
  lateFineType              FineType?
  lateFineAmount            Decimal?  @db.Decimal(10, 2)
  lateFinePerDay            Decimal?  @db.Decimal(10, 2)
  lateDepositFineAmount     Decimal?  @db.Decimal(10, 2) // Fixed late deposit fine
  lateEmiPenaltyPercent     Decimal?  @db.Decimal(5, 2) // % per week
  loanDefaultPenaltyPercent Decimal?  @db.Decimal(5, 2) // % increase/month

  // Loan rules
  loanInterestRate         Decimal?      @db.Decimal(5, 2) // Percentage
  loanInterestType         InterestType?
  allowedLoanTenures       String? // comma separated e.g. "3,6,12"
  maxLoanDurationMonths    Int?
  minLoanAmount            Decimal?      @db.Decimal(10, 2)
  maxLoanAmount            Decimal?      @db.Decimal(10, 2)
  loanProcessingFeePercent Decimal?      @db.Decimal(5, 2)
  savingsToLoanRatio       Decimal?      @db.Decimal(5, 2)
  emiPaymentDay            Int? // Day of month (1-31)

  // Versioning
  version       Int
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  // Change tracking
  previousRuleId String?
  changedBy      String
  changeNote     String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("group_rules")
}

enum RuleType {
  DEPOSIT
  FINE
  LOAN
  GENERAL
}

enum FineType {
  FLAT
  PER_DAY
}

enum InterestType {
  FLAT
  REDUCING
}

model GroupBalance {
  id String @id @default(cuid())

  // Relations
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  // Balance tracking
  balanceBefore Decimal @db.Decimal(10, 2)
  balanceAfter  Decimal @db.Decimal(10, 2)
  change        Decimal @db.Decimal(10, 2)

  // Breakdown (running totals)
  totalDeposits     Decimal @db.Decimal(10, 2)
  totalLoansOut     Decimal @db.Decimal(10, 2)
  totalRepaymentsIn Decimal @db.Decimal(10, 2)
  totalFines        Decimal @db.Decimal(10, 2)
  totalExpenses     Decimal @db.Decimal(10, 2)
  totalBankInterest Decimal @db.Decimal(10, 2)

  // Available balance (excluding loaned amount)
  availableBalance Decimal @db.Decimal(10, 2)

  // Metadata
  createdAt DateTime @default(now())

  @@index([groupId, createdAt])
  @@map("group_balances")
}

model Loan {
  id String @id @default(cuid())

  // Relations
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Loan details
  loanNumber      String       @unique // Format: FGFMS/2026/LOAN/000001
  principalAmount Decimal      @db.Decimal(10, 2)
  interestRate    Decimal      @db.Decimal(5, 2)
  interestType    InterestType
  durationMonths  Int

  // Calculated amounts
  totalInterest Decimal @db.Decimal(10, 2)
  totalAmount   Decimal @db.Decimal(10, 2) // Principal + Interest
  emiAmount     Decimal @db.Decimal(10, 2)

  // Status
  status  LoanStatus @default(REQUESTED)
  purpose String?

  // Approval
  requestedAt  DateTime  @default(now())
  approvedById String?
  approvedAt   DateTime?
  disbursedAt  DateTime?

  // Completion
  fullyPaidAt DateTime?

  // Notes
  notes String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  repayments  LoanRepayment[]
  receipt     Receipt?
  transaction Transaction?

  @@map("loans")
}

enum LoanStatus {
  REQUESTED
  APPROVED
  DISBURSED
  ACTIVE
  COMPLETED
  REJECTED
  DEFAULTED
}

model LoanRepayment {
  id String @id @default(cuid())

  // Relations
  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // EMI details
  emiNumber       Int
  dueDate         DateTime
  principalAmount Decimal  @db.Decimal(10, 2)
  interestAmount  Decimal  @db.Decimal(10, 2)
  totalAmount     Decimal  @db.Decimal(10, 2)

  // Payment details
  status      RepaymentStatus @default(PENDING)
  paidDate    DateTime?
  paidAmount  Decimal?        @db.Decimal(10, 2)
  paymentMode PaymentMode?

  // Fine
  fineAmount Decimal @default(0) @db.Decimal(10, 2)
  fineId     String?
  fine       Fine?   @relation(fields: [fineId], references: [id])

  // Approval
  confirmedById String?
  confirmedAt   DateTime?

  // Notes
  notes String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  receipt     Receipt?
  transaction Transaction?

  @@map("loan_repayments")
}

enum RepaymentStatus {
  PENDING
  PAID
  LATE
  PARTIAL
  WAIVED
}

model Member {
  id String @id @default(cuid())

  // Group relation
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // User relation
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Member details
  relation String? // e.g., "Brother", "Cousin"
  joinDate DateTime  @default(now())
  exitDate DateTime?

  // Status
  status MemberStatus @default(ACTIVE)
  role   MemberRole   @default(MEMBER)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin relation (who added this member)
  addedById String?
  addedBy   User?   @relation("AdminOf", fields: [addedById], references: [id])

  // Relations
  deposits           Deposit[]
  loans              Loan[]
  loanRepayments     LoanRepayment[]
  fines              Fine[]
  expenseSuggestions Expense[]         @relation("SuggestedBy")
  settlements        FinalSettlement[]
  notifications      Notification[]

  @@unique([groupId, userId])
  @@map("members")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  EXITED
}

enum MemberRole {
  ADMIN
  SECONDARY_ADMIN
  MEMBER
}

model Notification {
  id String @id @default(cuid())

  // Relations
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Notification details
  notificationType NotificationType
  title            String
  message          String

  // Reference (what triggered this?)
  entityType EntityType?
  entityId   String?

  // Delivery
  status NotificationStatus @default(PENDING)
  sentAt DateTime?

  // Read status
  isRead Boolean   @default(false)
  readAt DateTime?

  // Action
  actionUrl   String?
  actionLabel String?

  // Priority
  priority NotificationPriority @default(NORMAL)

  // Metadata
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([memberId, isRead, createdAt])
  @@index([groupId, notificationType])
  @@map("notifications")
}

enum NotificationType {
  DEPOSIT_DUE
  DEPOSIT_LATE
  LOAN_APPROVED
  LOAN_REJECTED
  LOAN_DISBURSED
  EMI_DUE
  EMI_LATE
  FINE_ADDED
  EXPENSE_APPROVED
  EXPENSE_REJECTED
  MONTHLY_REPORT_READY
  SETTLEMENT_READY
  ADMIN_MESSAGE
  SYSTEM_ALERT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Receipt {
  id String @id @default(cuid())

  // Relations
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Receipt details
  receiptNumber String      @unique // Format: FGFMS/2026/DEP/000001
  receiptType   ReceiptType

  // Transaction reference
  depositId String?  @unique
  deposit   Deposit? @relation(fields: [depositId], references: [id])

  loanId String? @unique
  loan   Loan?   @relation(fields: [loanId], references: [id])

  repaymentId String?        @unique
  repayment   LoanRepayment? @relation(fields: [repaymentId], references: [id])

  fineId String? @unique
  fine   Fine?   @relation(fields: [fineId], references: [id])

  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id])

  // Details
  memberName  String
  amount      Decimal     @db.Decimal(10, 2)
  paymentMode PaymentMode
  description String

  // Issuer
  issuedBy String // Admin name
  issuedAt DateTime @default(now())

  // PDF
  pdfUrl String?

  // Notes
  remarks String?

  // Metadata
  createdAt DateTime @default(now())

  @@map("receipts")
}

enum ReceiptType {
  DEPOSIT
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  FINE
  EXPENSE
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  WALLET
  CHEQUE
  OTHER
}

model ReceiptCounter {
  id String @id @default(cuid())

  // Relations
  groupId String

  // Counter details
  year        Int
  receiptType ReceiptType
  lastNumber  Int         @default(0)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  group     Group    @relation(fields: [groupId], references: [id])

  @@unique([groupId, year, receiptType])
  @@map("receipt_counters")
}

model MonthlyReport {
  id String @id @default(cuid())

  // Relations
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Report details
  monthYear    String // Format: "YYYY-MM"
  reportNumber String @unique // Format: FGFMS/2026/RPT/01

  // Financial summary
  openingBalance Decimal @db.Decimal(10, 2)
  closingBalance Decimal @db.Decimal(10, 2)

  totalDeposits     Decimal @db.Decimal(10, 2)
  totalLoans        Decimal @db.Decimal(10, 2)
  totalRepayments   Decimal @db.Decimal(10, 2)
  totalFines        Decimal @db.Decimal(10, 2)
  totalExpenses     Decimal @db.Decimal(10, 2)
  totalBankInterest Decimal @db.Decimal(10, 2)

  // Status
  status ReportStatus @default(DRAFT)

  // Generation
  generatedById String?
  generatedAt   DateTime?

  // PDF
  pdfUrl String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, monthYear])
  @@map("monthly_reports")
}

enum ReportStatus {
  DRAFT
  GENERATED
  LOCKED
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FinalSettlement {
  id String @id @default(cuid())

  // Relations
  memberId String @unique
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Calculation
  totalMandatoryDeposits  Decimal @db.Decimal(10, 2)
  totalExtraContributions Decimal @db.Decimal(10, 2)
  memberShareOfEarnings   Decimal @db.Decimal(10, 2)
  pendingLoanPrincipal    Decimal @db.Decimal(10, 2)

  // Final amount
  finalAmount Decimal @db.Decimal(10, 2)

  // Status
  status SettlementStatus @default(CALCULATED)

  // Settlement
  settledAt   DateTime?
  settledBy   String?
  paymentMode PaymentMode?

  // PDF
  pdfUrl String?

  // Notes
  notes String?

  // Metadata
  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("final_settlements")
}

enum SettlementStatus {
  CALCULATED
  APPROVED
  SETTLED
}

model Transaction {
  id String @id @default(cuid())

  // Relations
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Transaction details
  transactionNumber String              @unique // Format: FGFMS/2026/TXN/000001
  transactionType   TransactionType
  category          TransactionCategory

  // Amounts
  debitAmount  Decimal? @db.Decimal(10, 2)
  creditAmount Decimal? @db.Decimal(10, 2)
  balance      Decimal  @db.Decimal(10, 2)

  // Description
  description String

  // References (polymorphic)
  depositId String?  @unique
  deposit   Deposit? @relation(fields: [depositId], references: [id])

  loanId String? @unique
  loan   Loan?   @relation(fields: [loanId], references: [id])

  repaymentId String?        @unique
  repayment   LoanRepayment? @relation(fields: [repaymentId], references: [id])

  fineId String? @unique
  fine   Fine?   @relation(fields: [fineId], references: [id])

  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id])

  bankInterestId String?       @unique
  bankInterest   BankInterest? @relation(fields: [bankInterestId], references: [id])

  // Balance snapshot
  balanceSnapshot GroupBalance?

  // Metadata
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())

  @@map("transactions")
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum TransactionCategory {
  DEPOSIT
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  FINE
  EXPENSE
  BANK_INTEREST
  ADJUSTMENT
}

model User {
  id          String @id @default(cuid())
  phoneNumber String @unique
  name        String
  userName    String @unique
  email       String @unique

  // Auth
  passwordHash String?
  otpCode      String?
  otpExpiresAt DateTime?

  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  members     Member[]
  adminGroups Member[] @relation("AdminOf")

  @@map("users")
}
