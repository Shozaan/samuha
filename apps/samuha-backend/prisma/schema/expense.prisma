model Expense {
  id String @id @default(cuid())

  // Relations
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Expense details
  expenseType ExpenseType
  amount      Decimal     @db.Decimal(10, 2)
  description String

  // Status
  status ExpenseStatus @default(SUGGESTED)

  // Suggestion
  suggestedById String?
  suggestedBy   Member?   @relation("SuggestedBy", fields: [suggestedById], references: [id])
  suggestedAt   DateTime?

  // Approval
  approvedById String?
  approvedAt   DateTime?

  // Payment
  paidDate    DateTime?
  paymentMode PaymentMode?

  // Receipt/Invoice
  hasReceipt Boolean @default(false)
  receiptUrl String?

  // Notes
  notes String?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  receipt     Receipt?
  transaction Transaction?

  @@map("expenses")
}

enum ExpenseType {
  MEETING
  OUTING
  FOOD
  SOFTWARE
  HOSTING
  ACCOUNTANT
  AUDIT
  MISCELLANEOUS
}

enum ExpenseStatus {
  SUGGESTED
  APPROVED
  PAID
  REJECTED
}
